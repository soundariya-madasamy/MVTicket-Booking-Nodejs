  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:watch": "nodemon --exec nyc mocha --exit",
    "test": "mocha --timeout 10000 \"test/**/*.test.js\"",
    "coverage": "nyc --reporter=html --reporter=text mocha --timeout 10000 \"./test/**/*.test.js\""
  },
  "nyc": {
    "reporter": [
      "text",
      "html"
    ],
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**/*.js"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.18.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "sinon": "^21.0.1",
    "supertest": "^7.2.2"
  }
}
